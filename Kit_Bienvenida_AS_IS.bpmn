        <dc:Bounds x="1030" y="100" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_gw_necesita_di" bpmnElement="a_gw_necesita" isMarkerVisible="true">
        <dc:Bounds x="1360" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1350" y="450" width="70" height="27" />
