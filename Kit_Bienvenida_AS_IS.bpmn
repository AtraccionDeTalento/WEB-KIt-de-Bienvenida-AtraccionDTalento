<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_KitBienvenidaAsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_asis" name="Kit de Bienvenida - AS IS (proceso actual con PDF por correo)" processRef="Process_asis" />

    <bpmn:textAnnotation id="ann_pdf">
      <bpmn:text>El PDF es estatico: no tiene buscador, pesa varios MB y se visualiza mal en celular. Cada vez que cambia un dato (Socio de Negocio, contactos, etc.) hay que reeditar y reenviar el PDF a todos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_pdf" sourceRef="a_t2" targetRef="ann_pdf" />

    <bpmn:textAnnotation id="ann_busqueda">
      <bpmn:text>El colaborador debe pasar pagina por pagina buscando su area, su sede o el contacto correcto. No hay enlaces directos ni accesos a plataformas.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_busqueda" sourceRef="a_t3" targetRef="ann_busqueda" />

    <bpmn:textAnnotation id="ann_estacionamiento">
      <bpmn:text>Debe ubicar el formato Word dentro del PDF, descargarlo, llenarlo a mano y enviarlo por correo a varios destinatarios segun su sede.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_estacionamiento" sourceRef="a_t6" targetRef="ann_estacionamiento" />

    <bpmn:textAnnotation id="ann_cuello">
      <bpmn:text>Cuello de botella: Talento y Cultura responde manualmente cada consulta repetida, revisando el mismo PDF una y otra vez.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_cuello" sourceRef="a_t5" targetRef="ann_cuello" />
  </bpmn:collaboration>

  <bpmn:process id="Process_asis" name="AS IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_tyc" name="Atraccion de Talento / Talento y Cultura">
        <bpmn:flowNodeRef>a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_colaborador" name="Nuevo Colaborador">
        <bpmn:flowNodeRef>a_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_encuentra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw_necesita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_soporte" name="Areas de Soporte (Seguridad / Socio de Negocio / Contactos)">
        <bpmn:flowNodeRef>a_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="a_start" name="Nuevo ingreso" />
    <bpmn:task id="a_t1" name="Talento y Cultura envia el PDF 'Tool Kit de Bienvenida' por correo" />
    <bpmn:task id="a_t2" name="Colaborador recibe el correo y abre el PDF adjunto" bioc:stroke="#a23b2e" bioc:fill="#f6d8d3" />
    <bpmn:task id="a_t3" name="Navega manualmente pagina por pagina buscando su informacion" bioc:stroke="#a23b2e" bioc:fill="#f6d8d3" />
    <bpmn:exclusiveGateway id="a_gw_encuentra" name="Encuentra la informacion?" />
    <bpmn:task id="a_t5" name="Talento y Cultura responde la consulta revisando el PDF" bioc:stroke="#a23b2e" bioc:fill="#f6d8d3" />
    <bpmn:task id="a_t4" name="Escribe correo a Talento y Cultura con su duda" />
    <bpmn:exclusiveGateway id="a_gw_necesita" name="Que necesita?" />
    <bpmn:task id="a_t6" name="Descarga el Formato Vehicular del PDF, lo llena y lo envia por correo" bioc:stroke="#a23b2e" bioc:fill="#f6d8d3" />
    <bpmn:task id="a_t7" name="Ubica el contacto o Socio de Negocio de Talento y Cultura correcto en el PDF y escribe un correo" />
    <bpmn:task id="a_t8" name="El area responde y gestiona el tramite manualmente (dias de respuesta)" />
    <bpmn:endEvent id="a_end" name="Consulta resuelta (proceso lento y fragmentado)" />

    <bpmn:sequenceFlow id="a_sf1" sourceRef="a_start" targetRef="a_t1" />
    <bpmn:sequenceFlow id="a_sf2" sourceRef="a_t1" targetRef="a_t2" />
    <bpmn:sequenceFlow id="a_sf3" sourceRef="a_t2" targetRef="a_t3" />
    <bpmn:sequenceFlow id="a_sf4" sourceRef="a_t3" targetRef="a_gw_encuentra" />
    <bpmn:sequenceFlow id="a_sf5" name="No" sourceRef="a_gw_encuentra" targetRef="a_t4" />
    <bpmn:sequenceFlow id="a_sf6" sourceRef="a_t4" targetRef="a_t5" />
    <bpmn:sequenceFlow id="a_sf7" sourceRef="a_t5" targetRef="a_gw_necesita" />
    <bpmn:sequenceFlow id="a_sf8" name="Si" sourceRef="a_gw_encuentra" targetRef="a_gw_necesita" />
    <bpmn:sequenceFlow id="a_sf9" name="Estacionamiento" sourceRef="a_gw_necesita" targetRef="a_t6" />
    <bpmn:sequenceFlow id="a_sf10" name="Contacto / Socio de Negocio" sourceRef="a_gw_necesita" targetRef="a_t7" />
    <bpmn:sequenceFlow id="a_sf11" sourceRef="a_t6" targetRef="a_t8" />
    <bpmn:sequenceFlow id="a_sf12" sourceRef="a_t7" targetRef="a_t8" />
    <bpmn:sequenceFlow id="a_sf13" sourceRef="a_t8" targetRef="a_end" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_asis_di" bpmnElement="Participant_asis" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2450" height="620" />
