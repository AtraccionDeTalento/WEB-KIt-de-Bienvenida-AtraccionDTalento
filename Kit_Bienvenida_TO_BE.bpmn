<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_KitBienvenidaToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_tobe" name="Kit de Bienvenida - TO BE (portal web interactivo)" processRef="Process_tobe" />

    <bpmn:textAnnotation id="ann_portal">
      <bpmn:text>Portal tipo linktree, mobile-first. Talento y Cultura actualiza el contenido (Socios de Negocio, contactos, plataformas) directamente en la web: un solo lugar, siempre vigente, sin reenviar archivos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_portal" sourceRef="t_t1" targetRef="ann_portal" />

    <bpmn:textAnnotation id="ann_tarjetas">
      <bpmn:text>6 tarjetas de acceso directo: Socio de Negocio de Talento y Cultura, Plataformas Virtuales, Estacionamiento, Nuestros Campus, Principales Contactos y USIL SOS.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_tarjetas" sourceRef="t_t3" targetRef="ann_tarjetas" />

    <bpmn:textAnnotation id="ann_autoservicio">
      <bpmn:text>Cada modal resuelve la duda al instante: Socio de Negocio segun su area con correo directo, botones de acceso a plataformas, formulario descargable, mapa y QR de campus, telefono/correo de contacto directo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_autoservicio" sourceRef="t_t4" targetRef="ann_autoservicio" />

    <bpmn:textAnnotation id="ann_tramite">
      <bpmn:text>El formato y los correos de destino ya estan listos en el portal: el colaborador solo descarga, llena y envia, sin buscar en ningun documento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_tramite" sourceRef="t_t6" targetRef="ann_tramite" />

    <bpmn:textAnnotation id="ann_beneficio">
      <bpmn:text>Beneficio: se elimina el ida y vuelta de correos con Talento y Cultura para dudas basicas; la informacion se resuelve en segundos desde el celular.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_beneficio" sourceRef="t_end" targetRef="ann_beneficio" />
  </bpmn:collaboration>

  <bpmn:process id="Process_tobe" name="TO BE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_tyc" name="Atraccion de Talento / Talento y Cultura">
        <bpmn:flowNodeRef>t_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_colaborador" name="Nuevo Colaborador">
        <bpmn:flowNodeRef>t_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gw_categoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gw_tramite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sistema" name="Portal Web (automatico)">
        <bpmn:flowNodeRef>t_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="t_start" name="Nuevo ingreso" />
    <bpmn:task id="t_t1" name="Talento y Cultura comparte el link / QR del portal web" bioc:stroke="#2e7d5b" bioc:fill="#d7f0e2" />
    <bpmn:task id="t_t2" name="Colaborador escanea el QR o abre el link desde su celular" bioc:stroke="#2e7d5b" bioc:fill="#d7f0e2" />
    <bpmn:task id="t_t3" name="Visualiza el portal interactivo con tarjetas de acceso rapido" bioc:stroke="#2e7d5b" bioc:fill="#d7f0e2" />
    <bpmn:exclusiveGateway id="t_gw_categoria" name="Que necesita?" />
    <bpmn:task id="t_t4" name="Toca la tarjeta correspondiente y el modal muestra la informacion al instante" bioc:stroke="#2e7d5b" bioc:fill="#d7f0e2" />
    <bpmn:exclusiveGateway id="t_gw_tramite" name="Requiere un tramite? (ej. estacionamiento)" />
    <bpmn:task id="t_t5" name="Usa el enlace directo (mailto / tel / acceder) para resolver su duda" />
    <bpmn:task id="t_t6" name="Descarga el formato desde el portal, lo llena y envia el correo ya con los destinatarios indicados" />
    <bpmn:task id="t_t7" name="Comparte el portal con un compañero via boton Compartir (opcional)" />
    <bpmn:endEvent id="t_end" name="Necesidad resuelta al instante" />

    <bpmn:task id="t_t8" name="El portal centraliza y actualiza la informacion en tiempo real (Socios de Negocio, contactos, plataformas)" />

    <bpmn:sequenceFlow id="t_sf1" sourceRef="t_start" targetRef="t_t1" />
    <bpmn:sequenceFlow id="t_sf2" sourceRef="t_t1" targetRef="t_t2" />
    <bpmn:sequenceFlow id="t_sf3" sourceRef="t_t2" targetRef="t_t3" />
    <bpmn:sequenceFlow id="t_sf4" sourceRef="t_t3" targetRef="t_gw_categoria" />
    <bpmn:sequenceFlow id="t_sf5" name="Socio de Negocio / Plataformas / Campus / Contactos / SOS" sourceRef="t_gw_categoria" targetRef="t_t4" />
    <bpmn:sequenceFlow id="t_sf6" name="Estacionamiento" sourceRef="t_gw_categoria" targetRef="t_gw_tramite" />
    <bpmn:sequenceFlow id="t_sf7" sourceRef="t_t4" targetRef="t_gw_tramite" />
    <bpmn:sequenceFlow id="t_sf8" name="No" sourceRef="t_gw_tramite" targetRef="t_t5" />
    <bpmn:sequenceFlow id="t_sf9" name="Si" sourceRef="t_gw_tramite" targetRef="t_t6" />
    <bpmn:sequenceFlow id="t_sf10" sourceRef="t_t5" targetRef="t_t7" />
    <bpmn:sequenceFlow id="t_sf11" sourceRef="t_t6" targetRef="t_t7" />
    <bpmn:sequenceFlow id="t_sf12" sourceRef="t_t7" targetRef="t_end" />
    <bpmn:sequenceFlow id="t_sf13" sourceRef="t_t1" targetRef="t_t8" />
    <bpmn:sequenceFlow id="t_sf14" sourceRef="t_t8" targetRef="t_t3" />
  </bpmn:process>

